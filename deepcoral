\n    for i in range(n_classes):\n        fpr[i], tpr[i], _ = roc_curve(y_test_binarized[:, i], y_pred_proba[:, i])\n        roc_auc[i] = auc(fpr[i], tpr[i])\n        \n    plt.figure(figsize=(12, 9))\n    colors = cycle(['aqua', 'darkorange', 'cornflowerblue', 'green', 'red', 'purple'])\n    for i, color in zip(range(n_classes), colors):\n        plt.plot(fpr[i], tpr[i], color=color, lw=2,\n                 label=f'ROC curve of class {le.classes_[i]} (area = {roc_auc[i]:0.2f})')\n        \n    plt.plot([0, 1], [0, 1], 'k--', lw=2)\n    plt.xlim([0.0, 1.0])\n    plt.ylim([0.0, 1.05])\n    plt.xlabel('False Positive Rate')\n    plt.ylabel('True Positive Rate')\n    plt.title('Multi-Class ROC Curve for Optimized XGBoost Model')\n    plt.legend(loc=\"lower right\")\n    plt.show()\n\n    # 4. Feature Importance Plot for the Best Model\n    # Since we have many features, we visualize the top 20 most important ones.\n    \n    feature_importances = best_xgb.feature_importances_\n    \n    # Create more meaningful feature names\n    feature_names = []\n    stats = ['Var', 'Skew', 'Kurt', 'Entropy']\n    for ch in COMMON_CHANNELS_19:\n        for mode in range(1, 6): # 5 modes\n            for stat in stats:\n                feature_names.append(f'{ch}_M{mode}_{stat}')\n\n    # It's possible some features were dropped if a channel was missing.\n    # We should only consider the number of features that the model was trained on.\n    num_model_features = len(feature_importances)\n    \n    importance_df = pd.DataFrame({\n        'Feature': feature_names[:num_model_features],\n        'Importance': feature_importances\n    }).sort_values(by='Importance', ascending=False).head(20)\n\n    plt.figure(figsize=(12, 10))\n    sns.barplot(x='Importance', y='Feature', data=importance_df, palette='cubehelix')\n    plt.title('Top 20 Feature Importances from Optimized XGBoost Model')\n    plt.xlabel('Importance Score')\n    plt.ylabel('Feature')\n    plt.show()\n\nelse:\n    print(\"Could not generate plots. Please ensure cells 6 through 10 have been run successfully.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 🔍 Signal Representation and PSD Analysis\n\nVisualizes EEG signal power spectral densities (before and after harmonization) for representative subjects across datasets.","metadata":{}},{"cell_type":"code","source":"# =============================================================================\n# CELL 13: Signal Representation Analysis (PSD Plots)\n# =============================================================================\nif 'all_metadata' in locals():\n    print(\"\\nGenerating Signal Representation Plots...\")\n    \n    # Select one representative subject from each dataset\n    # We find the first occurrence of each dataset in the consolidated metadata\n    representative_subjects = all_metadata.drop_duplicates(subset=['dataset'])\n\n    for _, subject in representative_subjects.iterrows():\n        try:\n            print(f\"\\nPlotting for {subject['subject_id']} from {subject['dataset']} dataset...\")\n            \n            # 1. Load the original raw signal\n            file_path = subject['file_path']\n            if file_path.endswith('.set'):\n                raw_original = mne.io.read_raw_eeglab(file_path, preload=True, verbose=False)\n            else:\n                raw_original = mne.io.read_raw_edf(file_path, preload=True, verbose=False)\n            \n            # Create a copy for harmonization\n            raw_to_harmonize = raw_original.copy()\n            \n            # If it's a CAUEEG file, extract eyes-closed segments first\n            if subject['dataset'] == 'CAUEEG':\n                 raw_to_harmonize = extract_caueeg_eyes_closed(raw_to_harmonize, file_path)\n\n            # 2. Create the harmonized signal\n            raw_harmonized = preprocess_and_harmonize(raw_to_harmonize)\n            \n            # 3. Plot PSDs side-by-side\n            fig, axes = plt.subplots(1, 2, figsize=(18, 6), sharey=True)\n            \n            # Plot PSD before harmonization\n            raw_original.compute_psd(fmax=H_FREQ+10).plot(axes=axes[0], show=False)\n            axes[0].set_title(f'Before Harmonization (Original SFreq: {raw_original.info[\"sfreq\"]} Hz)')\n            axes[0].set_xlabel('Frequency (Hz)')\n            \n            # Plot PSD after harmonization\n            raw_harmonized.compute_psd().plot(axes=axes[1], show=False)\n            axes[1].set_title(f'After Harmonization (SFreq: {raw_harmonized.info[\"sfreq\"]} Hz)')\n            axes[1].set_xlabel('Frequency (Hz)')\n            \n            fig.suptitle(f'Power Spectral Density for Subject: {subject[\"subject_id\"]}', fontsize=16)\n            plt.tight_layout(rect=[0, 0.03, 1, 0.95]) # Adjust layout to prevent title overlap\n            plt.show()\n\n        except Exception as e:\n            print(f\"Could not plot for subject {subject['subject_id']}. Reason: {e}\")\n\nelse:\n    print(\"Metadata not found. Please run cell 4 to load data first.\")\n","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}