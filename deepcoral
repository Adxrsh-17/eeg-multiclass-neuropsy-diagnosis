ly.started":"2026-01-30T15:22:11.870365Z","shell.execute_reply":"2026-01-30T15:22:25.057970Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### ⚙️ Environment Setup and Library Imports\n\nImports all required Python libraries for EEG preprocessing, feature extraction, and machine learning.","metadata":{}},{"cell_type":"code","source":"# =============================================================================\n# CELL 1: Environment Setup and Imports\n# =============================================================================\nimport os\nimport glob\nimport pandas as pd\nimport numpy as np\nimport mne\nimport ewtpy\nimport json\nimport xgboost as xgb\nfrom scipy.stats import skew, kurtosis\nfrom sklearn.model_selection import train_test_split, GridSearchCV\nfrom sklearn.preprocessing import StandardScaler, LabelEncoder\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import classification_report, confusion_matrix, accuracy_score\nfrom imblearn.over_sampling import SMOTE\nfrom imblearn.combine import SMOTEENN\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport warnings\nimport torch\nfrom torch import nn\nfrom torch.utils.data import DataLoader, TensorDataset\n\nwarnings.filterwarnings('ignore')\nprint(\"Libraries imported successfully.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T15:22:25.060942Z","iopub.execute_input":"2026-01-30T15:22:25.061178Z","iopub.status.idle":"2026-01-30T15:22:31.872037Z","shell.execute_reply.started":"2026-01-30T15:22:25.061151Z","shell.execute_reply":"2026-01-30T15:22:31.871426Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 🗂️ Configuration and Global Constants\n\nDefines dataset paths, harmonization parameters, EEG channel configuration, and class label mappings.","metadata":{}},{"cell_type":"code","source":"# =============================================================================\n# CELL 2: Configuration and Constants\n# =============================================================================\n# --- Data Paths ---\n# IMPORTANT: Assumes the script is run from a directory containing the 'dataset' folder.\nBASE_DATA_PATH = '/kaggle/input/finaldataset/raw'\nOPENNEURO_PATH = os.path.join(BASE_DATA_PATH, 'ds004504')\nCAUEEG_PATH = os.path.join(BASE_DATA_PATH, 'caueeg')\nMUMTAZ_PATH = os.path.join(BASE_DATA_PATH, 'figshare_mdd')\n\n# --- Harmonization Parameters ---\nCOMMON_SAMPLING_RATE = 200  # Hz\nCOMMON_CHANNELS_19 = [\n    'Fp1', 'Fp2', 'F7', 'F3', 'Fz', 'F4', 'F8', 'T3', 'C3', 'Cz',\n    'C4', 'T4', 'T5', 'P3', 'Pz', 'P4', 'T6', 'O1', 'O2'\n]\nEPOCH_DURATION = 3  # seconds\nL_FREQ = 0.5 # Hz for band-pass filter\nH_FREQ = 45 # Hz for band-pass filter\n\n# --- Target Labels Mapping ---\n# Consolidating labels for multi-class classification\nLABEL_MAP = {\n    'A': 'AD', 'F': 'FTD', 'C': 'HC',  # OpenNeuro\n    'N': 'HC', 'MCI': 'MCI', 'AD': 'AD', 'FTD': 'FTD', # CAUEEG (simplified)\n    'H': 'HC', 'MDD': 'MDD' # Mumtaz\n}\nprint(\"Configuration set.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T15:22:31.872783Z","iopub.execute_input":"2026-01-30T15:22:31.873182Z","iopub.status.idle":"2026-01-30T15:22:31.879258Z","shell.execute_reply.started":"2026-01-30T15:22:31.873159Z","shell.execute_reply":"2026-01-30T15:22:31.878415Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 📥 Data Loading Functions\n\nImplements dataset-specific functions to load EEG metadata and file paths for OpenNeuro, CAUEEG, and Mumtaz datasets.","metadata":{}},{"cell_type":"code","source":"# =============================================================================\n# CELL 3: Data Loading Functions\n# =============================================================================\ndef load_openneuro_data(path):\n    \"\"\"Loads data from the OpenNeuro ds004504 dataset.\"\"\"\n    metadata = pd.read_csv(os.path.join(path, 'participants.tsv'), sep='\\t')\n    records = []\n    for _, row in metadata.iterrows():\n        subject_id = row['participant_id']\n        label = row['Group']\n        # Use the preprocessed data from the 'derivatives' folder\n        file_path = os.path.join(path, 'derivatives-edf_converted', subject_id, 'eeg', f'{subject_id}_task-eyesclosed_eeg.edf')\n        if os.path.exists(file_path):\n            records.append({\n                'subject_id': subject_id,\n                'diagnosis': LABEL_MAP.get(label, 'Unknown'),\n                'file_path': file_path,\n                'dataset': 'OpenNeuro'\n            })\n    return pd.DataFrame(records)\n\ndef load_caueeg_data(path):\n    \"\"\"Loads data from the CAUEEG dataset.\"\"\"\n    metadata = pd.read_excel(os.path.join(path, 'annotation.xlsx'))\n    records = []\n    for _, row in metadata.iterrows():\n        # Corrected column name from 'id' to 'serial'\n        subject_id_num = row['serial']\n        # Ensure ID is correctly formatted for filename matching\n        subject_id_str = f\"{int(subject_id_num):05d}\"\n        subject_id = f'sub-{subject_id_str}'\n\n        # New logic to determine diagnosis from available columns\n        label = 'N'  # Default to Normal/Healthy Control\n        if row.get('ad') == True or str(row.get('ad')).upper() == 'TRUE':\n            label = 'AD'\n        elif row.get('mci') == True or str(row.get('mci')).upper() == 'TRUE':\n            label = 'MCI'\n\n        file_path = os.path.join(path, 'signal', 'edf', f'{subject_id_str}.edf')\n        if os.path.exists(file_path):\n            records.append({\n                'subject_id': subject_id,\n                'diagnosis': LABEL_MAP.get(label, 'Unknown'),\n                'file_path': file_path,\n                'dataset': 'CAUEEG'\n            })\n    return pd.DataFrame(records)\n\n\ndef load_mumtaz_data(path):\n    \"\"\"Loads data from the Mumtaz MDD dataset.\"\"\"\n    records = []\n    # Healthy Subjects\n    for file_path in glob.glob(os.path.join(path, 'H Subjects', '*EC.edf')):\n        subject_id = os.path.basename(file_path).split(' ')[1]\n        records.append({\n            'subject_id': f'H-{subject_id}',\n            'diagnosis': 'HC',\n            'file_path': file_path,\n            'dataset': 'Mumtaz'\n        })\n    # MDD Subjects\n    for file_path in glob.glob(os.path.join(path, 'MDD Subjects', '*EC.edf')):\n        subject_id = os.path.basename(file_path).split(' ')[1]\n        records.append({\n            'subject_id': f'MDD-{subject_id}',\n            'diagnosis': 'MDD',\n            'file_path': file_path,\n            'dataset': 'Mumtaz'\n        })\n    return pd.DataFrame(records)\n\nprint(\"Data loading functions defined.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T15:22:31.880299Z","iopub.execute_input":"2026-01-30T15:22:31.881106Z","iopub.status.idle":"2026-01-30T15:22:31.894719Z","shell.execute_reply.started":"2026-01-30T15:22:31.881077Z","shell.execute_reply":"2026-01-30T15:22:31.893985Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 🧾 Dataset Consolidation\n\nLoads all datasets, merges metadata into a unified DataFrame, and displays class distribution across subjects.","metadata":{}},{"cell_type":"code","source":"# =============================================================================\n# CELL 4: Consolidate All Datasets\n# =============================================================================\ndf_openneuro = load_openneuro_data(OPENNEURO_PATH)\ndf_caueeg = load_caueeg_data(CAUEEG_PATH)\ndf_mumtaz = load_mumtaz_data(MUMTAZ_PATH)\n\n# Combine all metadata into a single DataFrame\nall_metadata = pd.concat([df_openneuro, df_caueeg, df_mumtaz], ignore_index=True)\nall_metadata.to_csv('all_metadata.csv', index=False)\n\nprint(\"All datasets loaded and consolidated.\")\nprint(f\"Total subjects found: {len(all_metadata)}\")\nprint(\"\\nClass distribution:\")\nprint(all_metadata['diagnosis'].value_counts())\nprint(\"\\nSample of metadata:\")\nprint(all_metadata.head())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T15:22:31.895567Z","iopub.execute_input":"2026-01-30T15:22:31.895821Z","iopub.status.idle":"2026-01-30T15:22:36.768519Z","shell.execute_reply.started":"2026-01-30T15:22:31.895801Z","shell.execute_reply":"2026-01-30T15:22:36.767814Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### Validate Channel names of individual datasets","metadata":{}},{"cell_type":"code","source":"raw = mne.io.read_raw_edf('/kaggle/input/finaldataset/raw/ds004504/derivatives-edf_converted/sub-001/eeg/sub-001_task-eyesclosed_eeg.edf', preload=True, verbose=False)\nprint(\"Dataset 1 - Channel names: \", raw.ch_names)\n\nraw = mne.io.read_raw_edf('/kaggle/input/finaldataset/raw/caueeg/signal/edf/00001.edf', preload=True, verbose=False)\nprint(\"Dataset 2 - Channel names: \", raw.ch_names)\n\nraw = mne.io.read_raw_edf('/kaggle/input/finaldataset/raw/figshare_mdd/H Subjects/H S1 EC.edf', preload=True, verbose=False)\nprint(\"Dataset 3 - Channel names: \", raw.ch_names)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T15:22:36.769512Z","iopub.execute_input":"2026-01-30T15:22:36.770041Z","iopub.status.idle":"2026-01-30T15:22:39.068241Z","shell.execute_reply.started":"2026-01-30T15:22:36.769998Z","shell.execute_reply":"2026-01-30T15:22:39.067570Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 🧠 Preprocessing and Feature Extraction Pipeline\n\nDefines functions for EEG preprocessing, harmonization, empirical wavelet transform (EWT) feature extraction, and entropy computation.","metadata":{}},{"cell_type":"code","source":"# =============================================================================\n# CELL 5: Preprocessing and Feature Extraction Pipeline\n# =============================================================================\nfrom joblib import Parallel, delayed\n\ndef extract_caueeg_eyes_closed(raw, file_path):\n    \"\"\"\n    For CAUEEG data, loads event data and crops the raw file to only include\n    'Eyes Closed' segments.\n    \"\"\"\n    subject_id_num_str = os.path.basename(file_path).split('.')[0]\n    event_file_path = os.path.join(CAUEEG_PATH, 'event', f'{subject_id_num_str}.json')\n\n    if not os.path.exists(event_file_path):\n        print(f\"Warning: Event file not found for {file_path}. Using entire recording.\")\n        return raw\n\n    with open(event_file_path, 'r') as f:\n        events = json.load(f)\n\n    segments = []\n    for i, event in enumerate(events):\n        if event[1] == 'Eyes Closed':\n            start_sample = event[0]\n            # Find the next event to determine the end of the segment\n            if i + 1 < len(events):\n                end_sample = events[i + 1][0]\n            else:\n                end_sample = raw.n_times\n\n            if end_sample > start_sample:\n                start_time = start_sample / raw.info['sfreq']\n                end_time = end_sample / raw.info['sfreq']\n                segments.append(raw.copy().crop(tmin=start_time, tmax=end_time))\n\n    if not segments:\n        print(f\"Warning: No 'Eyes Closed' segments found for {file_path}. Using entire recording.\")\n        return raw\n\n    return mne.concatenate_raws(segments)\n\ndef standardize_channel_names(raw):\n    \"\"\"\n    Renames EEG channels to a standard 10-20 format by removing dataset-specific\n    prefixes and suffixes. E.g., 'EEG Fp1-LE' -> 'Fp1', 'Fp1-AVG' -> 'Fp1'.\n    It also standardizes the case for central electrodes (e.g., 'FZ' -> 'Fz').\n    \"\"\"\n    channel_mapping = {}\n    central_electrodes = ['FZ', 'CZ', 'PZ']\n    \n    for ch_name in raw.ch_names:\n        standard_name = ch_name\n        \n        if standard_name.startswith('EEG '):\n            standard_name = standard_name.split(' ')[1]\n\n        if '-' in standard_name:\n            standard_name = standard_name.split('-')[0]\n            \n        if standard_name.upper() in central_electrodes:\n            standard_name = standard_name.capitalize()\n\n        if ch_name != standard_name:\n            channel_mapping[ch_name] = standard_name\n            \n    if channel_mapping:\n        raw.rename_channels(channel_mapping)\n        \n    return raw\n\ndef preprocess_and_harmonize(raw):\n    \"\"\"Applies harmonization steps to a single MNE Raw object.\"\"\"\n    raw = standardize_channel_names(raw)\n    available_channels = [ch for ch in COMMON_CHANNELS_19 if ch in raw.ch_names]\n    raw.pick_channels(available_channels)\n    raw.resample(COMMON_SAMPLING_RATE)\n    raw.filter(l_freq=L_FREQ, h_freq=H_FREQ, fir_design='firwin')\n    raw.set_eeg_reference('average', projection=True)\n    raw.apply_proj()\n    return raw\n\ndef shannon_entropy(data):\n    \"\"\"Calculates Shannon Entropy.\"\"\"\n    value, counts = np.unique(np.round(data, 4), return_counts=True)\n    probs = counts / counts.sum()\n    return -np.sum(probs * np.log2(probs))\n\ndef extract_ewt_features(epoch_data):\n    \"\"\"Extracts EWT-based features from a single epoch.\"\"\"\n    features = []\n    for channel_data in epoch_data:\n        ewt, mfb, boundaries = ewtpy.EWT1D(channel_data, N=5)\n        channel_features = []\n        for i in range(ewt.shape[1]):\n            mode = ewt[:, i]\n            channel_features.extend([\n                np.var(mode), skew(mode), kurtosis(mode), shannon_entropy(mode)\n            ])\n        features.extend(channel_features)\n    return features\n\nprint(\"Pipeline functions defined.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T15:22:39.069284Z","iopub.execute_input":"2026-01-30T15:22:39.070100Z","iopub.status.idle":"2026-01-30T15:22:39.081797Z","shell.execute_reply.started":"2026-01-30T15:22:39.070074Z","shell.execute_reply":"2026-01-30T15:22:39.080867Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### ⚡ Process Data and Build Feature Matrix\n\nIterates through all EEG files, applies preprocessing and feature extraction, and constructs the feature (X) and label (y) matrices.","metadata":{}},{"cell_type":"code","source":"# =============================================================================\n# CELL 6: Process All Data and Build Feature Matrix (PARALLELIZED)\n# =============================================================================\n\ndef process_single_subject(idx, row):\n    \"\"\"Processes one subject file and returns features, labels, and domains.\"\"\"\n    X_sub, y_sub, domains_sub = [], [], []\n\n    try:\n        if row['file_path'].endswith('.set'):\n            raw = mne.io.read_raw_eeglab(row['file_path'], preload=True, verbose=False)\n        else:\n            raw = mne.io.read_raw_edf(row['file_path'], preload=True, verbose=False)\n\n        # If it's a CAUEEG file, extract eyes-closed segments using event data\n        if row['dataset'] == 'CAUEEG':\n            raw = extract_caueeg_eyes_closed(raw, row['file_path'])\n\n        # Signal-level harmonization\n        raw_harmonized = preprocess_and_harmonize(raw)\n\n        # Epoch the harmonized signal\n        epochs = mne.make_fixed_length_epochs(\n            raw_harmonized,\n            duration=EPOCH_DURATION,\n            preload=True,\n            verbose=False\n        )\n\n        # Feature extraction per epoch\n        for epoch_data in epochs.get_data():\n            X_sub.append(extract_ewt_features(epoch_data))\n            y_sub.append(row['diagnosis'])\n            domains_sub.append(row['dataset'])\n\n        print(f\"Processed subject {idx + 1}/{len(all_metadata)}: {row['subject_id']} ({row['diagnosis']})\")\n\n    except Exception as e:\n        print(f\"Error processing {row['file_path']}: {e}\")\n\n    return X_sub, y_sub, domains_sub\n\n\nprint(\"Starting feature extraction process. This may take a while...\")\n\nresults = Parallel(\n    n_jobs=2,            # Kaggle-safe (usually 2 CPUs)\n    backend=\"loky\"\n)(\n    delayed(process_single_subject)(idx, row)\n    for idx, row in all_metadata.iterrows()\n)\n\n# Combine results\nX, y, domains = [], [], []\nfor X_sub, y_sub, d_sub in results:\n    X.extend(X_sub)\n    y.extend(y_sub)\n    domains.extend(d_sub)\n\nX = np.array(X)\ny = np.array(y)\ndomains = np.array(domains)\n\nprint(\"\\nFeature extraction complete.\")\nprint(f\"Feature matrix shape: {X.shape}\")\nprint(f\"Labels vector shape: {y.shape}\")\nprint(f\"Domain labels shape: {domains.shape}\")\nprint(\"Unique domains:\", np.unique(domains))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-29T15:04:34.844856Z","iopub.execute_input":"2026-01-29T15:04:34.845970Z","iopub.status.idle":"2026-01-29T19:56:33.252400Z","shell.execute_reply.started":"2026-01-29T15:04:34.845939Z","shell.execute_reply":"2026-01-29T19:56:33.250514Z"},"_kg_hide-output":true,"collapsed":true,"jupyter":{"outputs_hidden":true}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 💾 Save Extracted Features\n\nSaves the processed feature matrix and label array as .npy files for reuse in later training sessions.","metadata":{}},{"cell_type":"code","source":"# =============================================================================\n# CELL 7: Save Processed Features\n# =============================================================================\nif 'X' in locals() and X.shape[0] > 0:\n    # Define an output directory for the processed data\n    OUTPUT_DIR = 'processed_data'\n    if not os.path.exists(OUTPUT_DIR):\n        os.makedirs(OUTPUT_DIR)\n        \n    # Save the feature matrix (X) and labels (y) to disk\n    feature_file = os.path.join(OUTPUT_DIR, 'features.npy')\n    labels_file = os.path.join(OUTPUT_DIR, 'labels.npy')\n    domains_file = os.path.join(OUTPUT_DIR, 'domains.npy')  # 🔴 IMPORTANT\n    \n    np.save(feature_file, X)\n    np.save(labels_file, y)\n    np.save(domains_file, domains)  # 🔴 SAVE DOMAIN LABELS\n    \n    print(f\"Processed data saved successfully to '{OUTPUT_DIR}' directory.\")\n    print(f\"Features shape: {X.shape}\")\n    print(f\"Labels shape: {y.shape}\")\n    print(f\"Domains shape: {domains.shape}\")\nelse:\n    print(\"No data to save. Please run the feature extraction cell (CELL 6) first.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T02:06:39.976680Z","iopub.execute_input":"2026-01-30T02:06:39.977370Z","iopub.status.idle":"2026-01-30T02:06:41.477766Z","shell.execute_reply.started":"2026-01-30T02:06:39.977326Z","shell.execute_reply":"2026-01-30T02:06:41.476649Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### Load Saved features and labels from uploaded kaggle dataset","metadata":{}},{"cell_type":"code","source":"import os\nimport shutil\nimport numpy as np\n\n# Local output directory\noutput_folder = 'processed_data'\nos.makedirs(output_folder, exist_ok=True)\n\n# Files to copy and load\nfiles = {\n    'features.npy': 'features.npy',\n    'labels.npy': 'labels.npy',\n    'domains.npy': 'domains.npy'  # 🔴 IMPORTANT\n}\n\nfor src_name, dst_name in files.items():\n    src_path = f'/kaggle/input/ml-parameters/{src_name}'\n    dst_path = os.path.join(output_folder, dst_name)\n\n    if not os.path.exists(src_path):\n        raise FileNotFoundError(f\"Missing file: {src_path}\")\n\n    shutil.copy(src_path, dst_path)\n\nprint(\"Files copied successfully.\")\n\n# Load data into memory\nX = np.load(os.path.join(output_folder, 'features.npy'))\ny = np.load(os.path.join(output_folder, 'labels.npy'))\ndomains = np.load(os.path.join(output_folder, 'domains.npy'))\n\nprint(\"Data loaded successfully.\")\nprint(f\"Features shape: {X.shape}\")\nprint(f\"Labels shape: {y.shape}\")\nprint(f\"Domains shape: {domains.shape}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T15:22:39.086115Z","iopub.execute_input":"2026-01-30T15:22:39.086328Z","iopub.status.idle":"2026-01-30T15:22:43.790794Z","shell.execute_reply.started":"2026-01-30T15:22:39.086309Z","shell.execute_reply":"2026-01-30T15:22:43.790130Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### WGAN Feature-Space Harmonization","metadata":{}},{"cell_type":"code","source":"# =============================================================================\n# CELL 6b: WGAN Feature-Space Harmonization Across Datasets\n# =============================================================================\n\"\"\"\nThis cell applies a Wasserstein GAN with Gradient Penalty (WGAN-GP)\nto harmonize feature distributions across datasets.\n\nIdea:\n- We keep OpenNeuro (or the first domain found) as the reference domain.\n- We learn a generator G that maps features from non-reference domains\n  into the reference feature distribution.\n- After training, we replace non-reference samples in X with G(X_nonref).\n\nRequirements:\n- X: (n_samples, n_features) feature matrix (from CELL 6)\n- domains: (n_samples,) array with dataset names (e.g. 'OpenNeuro', 'CAUEEG', 'Mumtaz')\n\"\"\"\n\nfrom sklearn.preprocessing import MinMaxScaler\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(\"Using device:\", device)\n\nX = np.load('/kaggle/working/processed_data/features.npy')\ny = np.load('/kaggle/working/processed_data/labels.npy')\ndomains = np.load('/kaggle/working/processed_data/domains.npy')\n\nif 'X' not in locals() or 'domains' not in locals() or len(X) == 0:\n    print(\"X or domains not found. Please run CELL 6 (feature extraction) first.\")\nelse:\n    # -------------------------------------------------------------------------\n    # 1. Normalize features for stable WGAN training\n    # -------------------------------------------------------------------------\n    X = X.astype(np.float32)\n    scaler_wgan = MinMaxScaler()\n    X_norm = scaler_wgan.fit_transform(X)\n\n    # Infer available domains from the data\n    unique_domains = np.unique(domains)\n    print(\"Found domains:\", unique_domains)\n\n    # Choose reference domain (you can change this explicitly if desired)\n    # e.g., reference_domain = 'OpenNeuro'\n    reference_domain = unique_domains[0]\n    print(f\"Using '{reference_domain}' as reference domain for WGAN harmonization.\")\n\n    ref_mask = (domains == reference_domain)\n    nonref_mask = ~ref_mask\n\n    X_ref = X_norm[ref_mask]\n    X_nonref = X_norm[nonref_mask]\n\n    print(f\"Reference samples: {X_ref.shape[0]} | Non-reference samples: {X_nonref.shape[0]}\")\n\n    if X_ref.shape[0] < 10 or X_nonref.shape[0] < 10:\n        print(\"Too few samples in reference or non-reference sets for stable WGAN training.\")\n    else:\n        feature_dim = X_norm.shape[1]\n\n        # ---------------------------------------------------------------------\n        # 2. Define WGAN-GP Generator and Critic\n        # ---------------------------------------------------------------------\n        class Generator(nn.Module):\n            def __init__(self, input_dim):\n                super().__init__()\n                self.net = nn.Sequential(\n                    nn.Linear(input_dim, 128),\n                    nn.ReLU(),\n                    nn.Linear(128, 128),\n                    nn.ReLU(),\n                    nn.Linear(128, input_dim),\n                )\n\n            def forward(self, x):\n                return self.net(x)\n\n        class Critic(nn.Module):\n            def __init__(self, input_dim):\n                super().__init__()\n                self.net = nn.Sequential(\n                    nn.Linear(input_dim, 128),\n                    nn.LeakyReLU(0.2),\n                    nn.Linear(128, 128),\n                    nn.LeakyReLU(0.2),\n                    nn.Linear(128, 1),\n                )\n\n            def forward(self, x):\n                return self.net(x).view(-1)\n\n        G = Generator(feature_dim).to(device)\n        D = Critic(feature_dim).to(device)\n\n        # ---------------------------------------------------------------------\n        # 3. Optimizers and hyperparameters\n        # ---------------------------------------------------------------------\n        lr = 1e-4\n        n_epochs = 500          # you can increase if training is stable/fast\n        batch_size = 64\n        n_critic = 5            # number of critic updates per generator update\n        lambda_gp = 10.0        # gradient penalty weight\n\n        opt_G = torch.optim.Adam(G.parameters(), lr=lr, betas=(0.5, 0.9))\n        opt_D = torch.optim.Adam(D.parameters(), lr=lr, betas=(0.5, 0.9))\n\n        # ---------------------------------------------------------------------\n        # 4. DataLoaders for reference and non-reference samples\n        # ---------------------------------------------------------------------\n        tensor_ref = torch.tensor(X_ref, dtype=torch.float32)\n        tensor_nonref = torch.tensor(X_nonref, dtype=torch.float32)\n\n        loader_ref = DataLoader(tensor_ref, batch_size=batch_size, shuffle=True, drop_last=True)\n        loader_nonref = DataLoader(tensor_nonref, batch_size=batch_size, shuffle=True, drop_last=True)\n\n        # Helper: gradient penalty\n        def gradient_penalty(D, real, fake):\n            batch_size_local = real.size(0)\n            alpha = torch.rand(batch_size_local, 1, device=device)\n            alpha = alpha.expand_as(real)\n\n            interpolates = alpha * real + (1 - alpha) * fake\n            interpolates.requires_grad_(True)\n\n            d_interpolates = D(interpolates)\n            grad_outputs = torch.ones_like(d_interpolates)\n\n            gradients = torch.autograd.grad(\n                outputs=d_interpolates,\n                inputs=interpolates,\n                grad_outputs=grad_outputs,\n                create_graph=True,\n                retain_graph=True,\n                only_inputs=True\n            )[0]\n\n            gradients = gradients.view(batch_size_local, -1)\n            slopes = gradients.norm(2, dim=1)\n            gp = ((slopes - 1) ** 2).mean()\n            return gp\n\n        # ---------------------------------------------------------------------\n        # 5. Training loop\n        # ---------------------------------------------------------------------\n        print(\"Starting WGAN-GP training for harmonization...\")\n        for epoch in range(n_epochs):\n            # zip will iterate up to the shorter loader's length\n            for batch_ref, batch_nonref in zip(loader_ref, loader_nonref):\n                batch_ref = batch_ref.to(device)\n                batch_nonref = batch_nonref.to(device)\n\n                # --- Update Critic multiple times ---\n                for _ in range(n_critic):\n                    opt_D.zero_grad()\n\n                    fake_nonref = G(batch_nonref).detach()\n                    d_real = D(batch_ref)\n                    d_fake = D(fake_nonref)\n\n                    gp = gradient_penalty(D, batch_ref, fake_nonref)\n                    loss_D = -(d_real.mean() - d_fake.mean()) + lambda_gp * gp\n\n                    loss_D.backward()\n                    opt_D.step()\n\n                # --- Update Generator ---\n                opt_G.zero_grad()\n                fake_nonref = G(batch_nonref)\n                loss_G = -D(fake_nonref).mean()\n                loss_G.backward()\n                opt_G.step()\n\n            if (epoch + 1) % 50 == 0 or epoch == 0:\n                print(f\"Epoch {epoch+1}/{n_epochs} | \"\n                      f\"D loss: {loss_D.item():.4f} | G loss: {loss_G.item():.4f}\")\n\n        print(\"WGAN-GP training complete.\")\n\n        # ---------------------------------------------------------------------\n        # 6. Apply the trained generator to all non-reference samples\n        # ---------------------------------------------------------------------\n        G.eval()\n        with torch.no_grad():\n            tensor_nonref_fu