np\nimport scipy.linalg\nimport random\nimport os\n\n# --- CONFIGURATION ---\nSEED = 42\nBATCH_SIZE = 128\nLEARNING_RATE = 5e-4\nEPOCHS = 50\nCORAL_LAMBDA = 8.0\nHIDDEN_DIM = 256\nDROPOUT = 0.4\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n\n# Reproducibility\ndef seed_everything(seed=42):\n    random.seed(seed)\n    os.environ['PYTHONHASHSEED'] = str(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed(seed)\n\nseed_everything(SEED)\n\n# --- 1. ALIGNMENT FUNCTIONS ---\n\ndef euclidean_alignment(X_domain):\n    \"\"\"\n    Euclidean Alignment (EA): Whitens the data (Covariance -> Identity).\n    Formula: X_new = X * Cov^(-1/2)\n    \"\"\"\n    # 1. Center the data\n    mean = np.mean(X_domain, axis=0)\n    X_centered = X_domain - mean\n    \n    # 2. Compute Covariance\n    cov = np.cov(X_centered, rowvar=False)\n    \n    # 3. Compute Cov^(-1/2) using SVD for stability\n    # Regularize cov to prevent singular matrix errors\n    cov = cov + np.eye(cov.shape[0]) * 1e-5\n    \n    # SVD: Cov = U * S * V.T\n    U, S, V = np.linalg.svd(cov)\n    \n    # R^(-1/2) = U * S^(-1/2) * U.T\n    P = U @ np.diag(1.0 / np.sqrt(S)) @ U.T\n    \n    # 4. Transform\n    X_aligned = X_centered @ P\n    return X_aligned\n\ndef riemannian_alignment_proxy(X_domain):\n    \"\"\"\n    Riemannian Alignment (RA) Proxy for Feature Vectors.\n    Since we have vectors (not matrices), we apply a Log-Euclidean mapping\n    to 'positively defined' features (like Variance/Energy) to unroll the manifold,\n    followed by global centering.\n    \"\"\"\n    # 1. Log-Map: Stabilize large variance features (proxy for Tangent Space)\n    # We apply log(x + eps) to make distributions Gaussian-like\n    X_log = np.sign(X_domain) * np.log1p(np.abs(X_domain))\n    \n    # 2. Standardize (Center + Scale) in this new Tangent Space\n    scaler = StandardScaler()\n    X_aligned = scaler.fit_transform(X_log)\n    \n    return X_aligned\n\n# --- 2. MODEL DEFINITION ---\nclass DeepCORAL_Net(nn.Module):\n    def __init__(self, input_dim, hidden_dim, num_classes):\n        super().__init__()\n        self.features = nn.Sequential(\n            nn.Linear(input_dim, hidden_dim),\n            nn.BatchNorm1d(hidden_dim),\n            nn.ReLU(),\n            nn.Dropout(DROPOUT),\n            nn.Linear(hidden_dim, hidden_dim),\n            nn.BatchNorm1d(hidden_dim),\n            nn.ReLU()\n        )\n        self.bottleneck = nn.Linear(hidden_dim, hidden_dim // 2)\n        self.classifier = nn.Linear(hidden_dim // 2, num_classes)\n\n    def forward(self, x):\n        f_emb = self.features(x)\n        features = self.bottleneck(f_emb)\n        logits = self.classifier(features)\n        return logits, features\n\ndef coral_loss(source, target):\n    d = source.size(1)\n    xm = source.mean(0, keepdim=True) - source\n    xc = xm.t() @ xm / (source.size(0) - 1)\n    xo = target.mean(0, keepdim=True) - target\n    xo = xo.t() @ xo / (target.size(0) - 1)\n    loss = torch.sum((xc - xo) ** 2)\n    return loss / (4 * d * d)\n\n# --- 3. DATA LOADING ---\nif 'X' not in locals():\n    # Placeholder for loading your data\n    X = np.load('processed_data/features.npy')\n    y = np.load('processed_data/labels.npy')\n    domains = np.load('processed_data/domains.npy')\n\n# Binary Mapping\nhealthy_lbls = ['HC', 'N', 'H', 'Healthy']\ny_bin = np.where(np.isin(y, healthy_lbls), 0, 1)\nunique_domains = np.unique(domains)\n\n# --- 4. EXPERIMENT RUNNER ---\ndef run_lodo_experiment(alignment_method, method_name):\n    print(f\"\\n{'='*60}\")\n    print(f\"🧪 RUNNING: DeepCORAL + {method_name}\")\n    print(f\"{'='*60}\")\n    \n    results = []\n    \n    for target_domain in unique_domains:\n        # A. ALIGNMENT STEP (Preprocessing)\n        # We must align EACH domain independently BEFORE mixing them into Source/Target\n        # This prevents leakage and respects domain geometry.\n        \n        X_aligned_list = []\n        y_list = []\n        d_list = []\n        \n        # Align every domain individually\n        for dom in unique_domains:\n            mask = domains == dom\n            X_dom = X[mask]\n            \n            # Apply chosen alignment\n            if alignment_method == 'EA':\n                X_dom_aligned = euclidean_alignment(X_dom)\n            elif alignment_method == 'RA':\n                X_dom_aligned = riemannian_alignment_proxy(X_dom)\n            else:\n                X_dom_aligned = X_dom # No alignment (Baseline)\n            \n            X_aligned_list.append(X_dom_aligned)\n            y_list.append(y_bin[mask])\n            d_list.append(domains[mask])\n            \n        # Reconstruct full dataset after alignment\n        X_aligned = np.concatenate(X_aligned_list)\n        y_aligned = np.concatenate(y_list)\n        d_aligned = np.concatenate(d_list)\n        \n        # B. SPLIT (Source vs Target)\n        src_mask = d_aligned != target_domain\n        tgt_mask = d_aligned == target_domain\n        \n        X_src = X_aligned[src_mask]\n        y_src = y_aligned[src_mask]\n        X_tgt = X_aligned[tgt_mask]\n        y_tgt = y_aligned[tgt_mask]\n        \n        # Tensors\n        t_X_src = torch.tensor(X_src, dtype=torch.float32)\n        t_y_src = torch.tensor(y_src, dtype=torch.long)\n        t_X_tgt = torch.tensor(X_tgt, dtype=torch.float32)\n        \n        # Loader\n        train_loader = DataLoader(TensorDataset(t_X_src, t_y_src), batch_size=BATCH_SIZE, shuffle=True, drop_last=True)\n        tgt_loader_iter = DataLoader(TensorDataset(t_X_tgt), batch_size=BATCH_SIZE, shuffle=True, drop_last=True)\n        \n        # Model\n        model = DeepCORAL_Net(X.shape[1], HIDDEN_DIM, 2).to(device)\n        if torch.cuda.device_count() > 1: model = nn.DataParallel(model)\n        optimizer = optim.AdamW(model.parameters(), lr=LEARNING_RATE)\n        criterion = nn.CrossEntropyLoss()\n        \n        # C. TRAINING LOOP (DeepCORAL)\n        for epoch in range(EPOCHS):\n            model.train()\n            tgt_iter = iter(tgt_loader_iter)\n            \n            for bx, by in train_loader:\n                bx, by = bx.to(device), by.to(device)\n                \n                # Get Target Batch for CORAL\n                try:\n                    bt = next(tgt_iter)[0].to(device)\n                except StopIteration:\n                    tgt_iter = iter(tgt_loader_iter)\n                    bt = next(tgt_iter)[0].to(device)\n                \n                if bx.size(0) != bt.size(0): continue\n                \n                optimizer.zero_grad()\n                \n                logits_s, feats_s = model(bx)\n                logits_t, feats_t = model(bt)\n                \n                loss = criterion(logits_s, by) + (CORAL_LAMBDA * coral_loss(feats_s, feats_t))\n                loss.backward()\n                optimizer.step()\n        \n        # D. EVALUATION\n        model.eval()\n        with torch.no_grad():\n            logits, _ = model(t_X_tgt.to(device))\n            probs = torch.softmax(logits, dim=1)[:, 1]\n            preds = torch.argmax(logits, dim=1)\n            \n            acc = accuracy_score(y_tgt, preds.cpu().numpy())\n            try: auc = roc_auc_score(y_tgt, probs.cpu().numpy())\n            except: auc = 0.5\n            \n        print(f\"   Target: {target_domain:<10} | Acc: {acc:.4f} | AUC: {auc:.4f}\")\n        results.append({'domain': target_domain, 'acc': acc, 'auc': auc})\n        \n    return results\n\n# --- 5. EXECUTE BOTH EXPERIMENTS ---\n\n# Experiment 1: Euclidean Alignment (Whitening)\nresults_ea = run_lodo_experiment('EA', 'Euclidean Alignment (Whitening)')\n\n# Experiment 2: Riemannian Alignment (Log-Map Proxy)\nresults_ra = run_lodo_experiment('RA', 'Riemannian Alignment (Log-Map)')\n\n# --- 6. FINAL COMPARISON REPORT ---\nprint(\"\\n\" + \"=\"*60)\nprint(\"🏆 FINAL COMPARISON: GEOMETRIC ALIGNMENT METHODS\")\nprint(\"=\"*60)\nprint(f\"{'Target Domain':<15} | {'Euclidean (Acc)':<15} | {'Riemannian (Acc)':<15} | {'Improvement':<15}\")\nprint(\"-\" * 65)\n\navg_ea = np.mean([r['acc'] for r in results_ea])\navg_ra = np.mean([r['acc'] for r in results_ra])\n\nfor i, dom in enumerate(unique_domains):\n    acc_ea = results_ea[i]['acc']\n    acc_ra = results_ra[i]['acc']\n    diff = acc_ra - acc_ea\n    impr = \"✅\" if diff > 0 else \"🔻\"\n    print(f\"{dom:<15} | {acc_ea:.4f}          | {acc_ra:.4f}          | {diff:+.4f} {impr}\")\n\nprint(\"-\" * 65)\nprint(f\"{'AVERAGE':<15} | {avg_ea:.4f}          | {avg_ra:.4f}          | {avg_ra - avg_ea:+.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T16:09:15.438860Z","iopub.execute_input":"2026-01-30T16:09:15.439669Z","iopub.status.idle":"2026-01-30T16:27:43.557905Z","shell.execute_reply.started":"2026-01-30T16:09:15.439635Z","shell.execute_reply":"2026-01-30T16:27:43.556887Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# =============================================================================\n# DeepCORAL ONLY (No Geometric Alignment)\n# Dataset: /kaggle/input/ml-parameters\n# =============================================================================\n\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.metrics import (\n    accuracy_score, roc_auc_score, f1_score,\n    balanced_accuracy_score, matthews_corrcoef\n)\nimport numpy as np\nimport random\nimport os\nfrom collections import defaultdict\n\n# ---------------- CONFIG ----------------\nSEED = 42\nBATCH_SIZE = 64\nLEARNING_RATE = 1e-3\nEPOCHS = 60\nCORAL_LAMBDA = 1.0\nHIDDEN_DIM = 512\nDROPOUT = 0.3\nWEIGHT_DECAY = 1e-4\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n\n# ---------------- SEED ----------------\ndef seed_everything(seed=42):\n    random.seed(seed)\n    os.environ['PYTHONHASHSEED'] = str(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed(seed)\n    torch.backends.cudnn.deterministic = True\n    torch.backends.cudnn.benchmark = False\n\nseed_everything(SEED)\n\n# ---------------- MODEL ----------------\nclass DeepCORAL(nn.Module):\n    def __init__(self, input_dim, hidden_dim, num_classes):\n        super().__init__()\n        self.feature_extractor = nn.Sequential(\n            nn.Linear(input_dim, hidden_dim),\n            nn.BatchNorm1d(hidden_dim),\n            nn.ReLU(),\n            nn.Dropout(DROPOUT),\n\n            nn.Linear(hidden_dim, hidden_dim),\n            nn.BatchNorm1d(hidden_dim),\n            nn.ReLU(),\n            nn.Dropout(DROPOUT),\n\n            nn.Linear(hidden_dim, hidden_dim // 2),\n            nn.ReLU()\n        )\n\n        self.classifier = nn.Linear(hidden_dim // 2, num_classes)\n\n    def forward(self, x):\n        features = self.feature_extractor(x)\n        logits = self.classifier(features)\n        return logits, features\n\n\ndef coral_loss(source, target):\n    d = source.size(1)\n\n    xm = source - source.mean(0, keepdim=True)\n    xc = xm.t() @ xm / (source.size(0) - 1)\n\n    xm_t = target - target.mean(0, keepdim=True)\n    xt = xm_t.t() @ xm_t / (target.size(0) - 1)\n\n    loss = torch.sum((xc - xt) ** 2)\n    return loss / (4 * d * d)\n\n\ndef compute_metrics(y_true, y_pred, y_probs):\n    return {\n        'acc': accuracy_score(y_true, y_pred),\n        'b_acc': balanced_accuracy_score(y_true, y_pred),\n        'f1': f1_score(y_true, y_pred, zero_division=0),\n        'mcc': matthews_corrcoef(y_true, y_pred),\n        'auc': roc_auc_score(y_true, y_probs) if len(np.unique(y_true)) > 1 else 0.5\n    }\n\n# ---------------- DATA ----------------\nDATA_PATH = \"/kaggle/input/ml-parameters\"\n\nX = np.load(f\"{DATA_PATH}/features.npy\")\ny = np.load(f\"{DATA_PATH}/labels.npy\")\ndomains = np.load(f\"{DATA_PATH}/domains.npy\")\n\n# Binary mapping\nhealthy_lbls = ['HC', 'N', 'H', 'Healthy']\ny_bin = np.where(np.isin(y, healthy_lbls), 0, 1)\nunique_domains = np.unique(domains)\n\n# ---------------- EXPERIMENT ----------------\ndef run_deepcoral():\n    results = defaultdict(list)\n\n    for target_domain in unique_domains:\n        print(f\"\\nTarget Domain: {target_domain}\")\n\n        src_mask = domains != target_domain\n        tgt_mask = domains == target_domain\n\n        X_src, y_src = X[src_mask], y_bin[src_mask]\n        X_tgt, y_tgt = X[tgt_mask], y_bin[tgt_mask]\n\n        # Tensors\n        t_X_src = torch.tensor(X_src, dtype=torch.float32)\n        t_y_src = torch.tensor(y_src, dtype=torch.long)\n        t_X_tgt = torch.tensor(X_tgt, dtype=torch.float32)\n\n        train_loader = DataLoader(\n            TensorDataset(t_X_src, t_y_src),\n            batch_size=BATCH_SIZE,\n            shuffle=True,\n            drop_last=True\n        )\n\n        tgt_loader = DataLoader(\n            TensorDataset(t_X_tgt),\n            batch_size=BATCH_SIZE,\n            shuffle=True,\n            drop_last=True\n        )\n\n        model = DeepCORAL(X.shape[1], HIDDEN_DIM, 2).to(device)\n        optimizer = optim.AdamW(model.parameters(),\n                                lr=LEARNING_RATE,\n                                weight_decay=WEIGHT_DECAY)\n        criterion = nn.CrossEntropyLoss()\n\n        # -------- TRAIN --------\n        for epoch in range(EPOCHS):\n            model.train()\n            tgt_iter = iter(tgt_loader)\n\n            for bx, by in train_loader:\n                bx, by = bx.to(device), by.to(device)\n\n                try:\n                    bt = next(tgt_iter)[0].to(device)\n                except:\n                    tgt_iter = iter(tgt_loader)\n                    bt = next(tgt_iter)[0].to(device)\n\n                if bx.size(0) != bt.size(0):\n                    continue\n\n                optimizer.zero_grad()\n\n                logits_src, feat_src = model(bx)\n                _, feat_tgt = model(bt)\n\n                loss_cls = criterion(logits_src, by)\n                loss_coral = coral_loss(feat_src, feat_tgt)\n\n                loss = loss_cls + CORAL_LAMBDA * loss_coral\n                loss.backward()\n                optimizer.step()\n\n        # -------- EVAL --------\n        model.eval()\n        with torch.no_grad():\n            logits, _ = model(t_X_tgt.to(device))\n            probs = torch.softmax(logits, dim=1)[:, 1].cpu().numpy()\n            preds = torch.argmax(logits, dim=1).cpu().numpy()\n\n        mets = compute_metrics(y_tgt, preds, probs)\n\n        print(f\"Acc: {mets['acc']:.4f} | AUC: {mets['auc']:.4f}\")\n\n        for k, v in mets.items():\n            results[k].append(v)\n\n    return results\n\n\n# ---------------- RUN ----------------\nres = run_deepcoral()\n\nprint(\"\\n===== FINAL AVERAGE RESULTS =====\")\nfor k in res:\n    print(f\"{k}: {np.mean(res[k]):.4f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-02-17T15:24:22.155311Z","iopub.execute_input":"2026-02-17T15:24:22.155931Z","iopub.status.idle":"2026-02-17T15:42:54.935896Z","shell.execute_reply.started":"2026-02-17T15:24:22.155899Z","shell.execute_reply":"2026-02-17T15:42:54.935007Z"}},"outputs":[{"name":"stdout","text":"\nTarget Domain: CAUEEG\nAcc: 0.5005 | AUC: 0.5237\n\nTarget Domain: Mumtaz\nAcc: 0.5290 | AUC: 0.5526\n\nTarget Domain: OpenNeuro\nAcc: 0.5195 | AUC: 0.5633\n\n===== FINAL AVERAGE RESULTS =====\nacc: 0.5163\nb_acc: 0.5308\nf1: 0.5098\nmcc: 0.0623\nauc: 0.5465\n","output_type":"stream"}],"execution_count":2},{"cell_type":"markdown","source":"## COMBAT ","metadata":{}},{"cell_type":"code","source":"!pip install neuroCombat","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-02-20T14:00:05.826113Z","iopub.execute_input":"2026-02-20T14:00:05.826470Z","iopub.status.idle":"2026-02-20T14:00:13.275586Z","shell.execute_reply.started":"2026-02-20T14:00:05.826440Z","shell.execute_reply":"2026-02-20T14:00:13.274557Z"}},"outputs":[{"name":"stdout","text":"Co