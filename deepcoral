score(y_test, y_pred)\n    f1_macro = f1_score(y_test, y_pred, average='macro')\n    f1_weighted = f1_score(y_test, y_pred, average='weighted')\n    \n    # ROC-AUC requires binarized labels for multiclass\n    y_test_bin = label_binarize(y_test, classes=range(n_classes))\n    auc_score = roc_auc_score(y_test_bin, y_pred_proba, average='macro', multi_class='ovr')\n\n    print(f\"\\n--- {title_prefix} Performance ---\")\n    print(f\"Accuracy:      {acc:.4f}\")\n    print(f\"Macro F1:      {f1_macro:.4f}\")\n    print(f\"Weighted F1:   {f1_weighted:.4f}\")\n    print(f\"ROC-AUC:       {auc_score:.4f}\")\n    \n    return y_test, y_pred\n\n# --- 5. RUN EXPERIMENTS ---\nprint(\"\\n\" + \"=\"*50)\nprint(\"EXPERIMENT 1: WITHOUT COMBAT (Baseline)\")\nprint(\"=\"*50)\ny_test_base, y_pred_base = evaluate_pipeline(X, y_encoded, \"Baseline (No ComBat)\")\n\nprint(\"\\n\" + \"=\"*50)\nprint(\"EXPERIMENT 2: WITH COMBAT HARMONIZATION\")\nprint(\"=\"*50)\ny_test_cb, y_pred_cb = evaluate_pipeline(X_combat, y_encoded, \"ComBat Harmonized\")\n\n# --- 6. VISUALIZATION (CONFUSION MATRICES) ---\ncm_base = confusion_matrix(y_test_base, y_pred_base)\ncm_cb = confusion_matrix(y_test_cb, y_pred_cb)\n\nfig, axes = plt.subplots(1, 2, figsize=(16, 6))\n\nsns.heatmap(cm_base, annot=True, fmt='d', cmap='Blues', \n            xticklabels=le.classes_, yticklabels=le.classes_, ax=axes[0])\naxes[0].set_title('Confusion Matrix: BEFORE ComBat', fontsize=14)\naxes[0].set_ylabel('True Label')\naxes[0].set_xlabel('Predicted Label')\n\nsns.heatmap(cm_cb, annot=True, fmt='d', cmap='Greens', \n            xticklabels=le.classes_, yticklabels=le.classes_, ax=axes[1])\naxes[1].set_title('Confusion Matrix: AFTER ComBat', fontsize=14)\naxes[1].set_ylabel('True Label')\naxes[1].set_xlabel('Predicted Label')\n\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-02-20T14:00:28.098370Z","iopub.execute_input":"2026-02-20T14:00:28.098719Z","iopub.status.idle":"2026-02-2