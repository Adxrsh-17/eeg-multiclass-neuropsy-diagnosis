ses_),\n        eval_metric='mlogloss',\n        use_label_encoder=False,\n        random_state=42\n    )\n    xgb_model.fit(X_train_scaled, y_train_encoded)\n\n    # 5. Make predictions\n    y_pred_encoded_xgb = xgb_model.predict(X_test_scaled_xgb)\n    \n    # 6. Decode predictions for evaluation\n    y_pred_xgb = le.inverse_transform(y_pred_encoded_xgb)\n    y_test_xgb = le.inverse_transform(y_test_encoded_xgb)\n    \n    # 7. Evaluate the model\n    accuracy_xgb = accuracy_score(y_test_xgb, y_pred_xgb)\n    report_xgb = classification_report(y_test_xgb, y_pred_xgb)\n\n    print(f\"\\nModel Accuracy (XGBoost): {accuracy_xgb:.4f}\")\n    print(\"\\nClassification Report (XGBoost):\")\n    print(report_xgb)\n\n    # 8. Confusion Matrix\n    cm_xgb = confusion_matrix(y_test_xgb, y_pred_xgb, labels=le.classes_)\n    \n    plt.figure(figsize=(10, 8))\n    sns.heatmap(cm_xgb, annot=True, fmt='d', cmap='Greens',\n                xticklabels=le.classes_, yticklabels=le.classes_)\n    plt.title('Confusion Matrix (XGBoost)')\n    plt.ylabel('True Label')\n    plt.xlabel('Predicted Label')\n    plt.show()\nelse:\n    print(\"Feature matrix is empty. Please run feature extraction (CELL 6) or load data first.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 🔧 Data Augmentation and XGBoost Hyperparameter Optimization\n\nApplies SMOTE to balance classes, performs grid search–based hyperparameter tuning for XGBoost, and evaluates the optimized model. SMOTE and SMOTE-ENN Failed to perform better, so they are commented out here.","metadata":{}},{"cell_type":"code","source":"# =============================================================================\n# CELL 10: Data Augmentation and Hyperparameter Optimization for XGBoost\n# =============================================================================\n\nX = np.load('processed_data/features.npy')\ny = np.load('processed_data/labels.npy')\n\nif 'X' in locals() and X.shape[0] > 0:\n    # 1. Encode labels\n    le = LabelEncoder()\n    y_encoded = le.fit_transform(y)\n    \n    # 2. Split data into training and testing sets\n    X_train, X_test, y_train_encoded, y_test_encoded_opt = train_test_split(\n        X, y_encoded, test_size=0.25, random_state=42, stratify=y_encoded\n    )\n\n    # 3. Scale features\n    scaler = StandardScaler()\n    X_train_scaled = scaler.fit_transform(X_train)\n    X_test_scaled_opt = scaler.transform(X_test)\n\n    # 4. Apply SMOTE-ENN for Data Augmentation on the training data\n    # print(\"\\nApplying SMOTE-ENN to balance and clean the training data...\")\n    # smote_enn = SMOTEENN(random_state=42)\n    # X_train_resampled, y_train_resampled = smote_enn.fit_resample(X_train_scaled, y_train_encoded)\n    # print(\"SMOTE-ENN applied. New training set size:\", X_train_resampled.shape)\n    \n    # 4. Apply SMOTE for Data Augmentation on the training data\n    # print(\"\\nApplying SMOTE to balance the training data...\")\n    # smote = SMOTE(random_state=42)\n    # X_train_resampled, y_train_resampled = smote.fit_resample(X_train_scaled, y_train_encoded)\n    # print(\"SMOTE applied. New training set size:\", X_train_resampled.shape)\n\n    # Without SMOTE\n    X_train_resampled, y_train_resampled = X_train_scaled, y_train_encoded\n\n    # 5. Hyperparameter tuning using GridSearchCV\n    print(\"\\nStarting Hyperparameter tuning for XGBoost...\")\n    param_grid = {\n        'n_estimators': [700],\n        'max_depth': [9],\n        'learning_rate': [0.2],\n        'subsample': [1.0]\n    }\n\n    xgb_model_opt = xgb.XGBClassifier(\n        objective='multi:softmax',\n        num_class=len(le.classes_),\n        eval_metric='mlogloss',\n        tree_method='hist',\n        device='cuda',\n        use_label_encoder=False,\n        random_state=42\n    )\n\n    grid_search = GridSearchCV(\n        estimator=xgb_model_opt,\n        param_grid=param_grid,\n        scoring='accuracy',\n        cv=5, # 5-fold cross-validation\n        n_jobs=-1, # Use all available CPU cores\n        verbose=1\n    )\n    \n    grid_search.fit(X_train_resampled, y_train_resampled)\n\n    print(\"\\nBest parameters found: \", grid_search.best_params_)\n\n    # 6. Train the final model with the best parameters\n    best_xgb = grid_search.best_estimator_\n\n    # 7. Make predictions on the original (un-augmented) test set\n    y_pred_encoded_opt = best_xgb.predict(X_test_scaled_opt)\n    \n    # 8. Decode and Evaluate\n    y_pred_opt = le.inverse_transform(y_pred_encoded_opt)\n    y_test_opt = le.inverse_transform(y_test_encoded_opt)\n    \n    accuracy_opt = accuracy_score(y_test_opt, y_pred_opt)\n    report_opt = classification_report(y_test_opt, y_pred_opt)\n\n    print(f\"\\nModel Accuracy (Optimized XGBoost): {accuracy_opt:.4f}\")\n    print(\"\\nClassification Report (Optimized XGBoost):\")\n    print(report_opt)\n\n    # 9. Confusion Matrix\n    cm_opt = confusion_matrix(y_test_opt, y_pred_opt, labels=le.classes_)\n    \n    plt.figure(figsize=(10, 8))\n    sns.heatmap(cm_opt, annot=True, fmt='d', cmap='Oranges',\n                xticklabels=le.classes_, yticklabels=le.classes_)\n    plt.title('Confusion Matrix (Optimized XGBoost)')\n    plt.ylabel('True Label')\n    plt.xlabel('Predicted Label')\n    plt.show()\n\nelse:\n    print(\"Feature matrix is empty. Please run feature extraction (CELL 6) or load data first.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 🎯 Optimized XGBoost for Major Classes (AD, MCI, HC)\n\nFocuses on key diagnostic categories, retrains and tunes an XGBoost model on filtered data, and evaluates classification performance.","metadata":{}},{"cell_type":"code","source":"# =============================================================================\n# CELL 11: Optimized XGBoost for Major Classes (AD, MCI, HC)\n# =============================================================================\nX = np.load('processed_data/features.npy')\ny = np.load('processed_data/labels.npy')\n\nif 'X' in locals() and X.shape[0] > 0:\n    # 1. Filter data for major classes\n    major_classes = ['AD', 'MCI', 'HC']\n    mask = np.isin(y, major_classes)\n    X_major = X[mask]\n    y_major = y[mask]\n    \n    print(f\"\\nTraining model on major classes: {major_classes}\")\n    print(f\"Filtered data shape: {X_major.shape}\")\n\n    # 2. Encode labels for the subset\n    le_major = LabelEncoder()\n    y_major_encoded = le_major.fit_transform(y_major)\n\n    # 3. Split the filtered data\n    X_train_major, X_test_major, y_train_major, y_test_major = train_test_split(\n        X_major, y_major_encoded, test_size=0.25, random_state=42, stratify=y_major_encoded\n    )\n\n    # 4. Scale features for the subset\n    scaler_major = StandardScaler()\n    X_train_scaled_major = scaler_major.fit_transform(X_train_major)\n    X_test_scaled_major = scaler_major.transform(X_test_major)\n\n    # 5. Apply SMOTE to the major classes training data\n    # print(\"\\nApplying SMOTE to the major classes training data...\")\n    # smote_major = SMOTE(random_state=42)\n    # X_train_resampled_major, y_train_resampled_major = smote_major.fit_resample(\n    #    X_train_scaled_major, y_train_major\n    # )\n\n    X_train_resampled_major, y_train_resampled_major = X_train_scaled_major, y_train_major\n\n    # 6. Hyperparameter tuning for the 3-class problem\n    print(\"\\nStarting Hyperparameter tuning for the 3-class XGBoost model...\")\n    # Using the same parameter grid as before, but it could be tuned further\n    param_grid_major = {\n        'n_estimators': [300],\n        'max_depth': [7],\n        'learning_rate': [0.2],\n    }\n\n    xgb_model_major = xgb.XGBClassifier(\n        objective='multi:softmax',\n        num_class=len(le_major.classes_),\n        eval_metric='mlogloss',\n        tree_method='hist',\n        device='cuda',\n        use_label_encoder=False,\n        random_state=42\n    )\n\n    grid_search_major = GridSearchCV(\n        estimator=xgb_model_major,\n        param_grid=param_grid_major,\n        scoring='accuracy',\n        cv=5,\n        n_jobs=-1,\n        verbose=1\n    )\n    \n    grid_search_major.fit(X_train_resampled_major, y_train_resampled_major)\n\n    print(\"\\nBest parameters for 3-class model: \", grid_search_major.best_params_)\n\n    # 7. Evaluate the best model for major classes\n    best_xgb_major = grid_search_major.best_estimator_\n    y_pred_encoded_major = best_xgb_major.predict(X_test_scaled_major)\n    \n    y_pred_major = le_major.inverse_transform(y_pred_encoded_major)\n    y_test_major_decoded = le_major.inverse_transform(y_test_major)\n\n    accuracy_major = accuracy_score(y_test_major_decoded, y_pred_major)\n    report_major = classification_report(y_test_major_decoded, y_pred_major)\n\n    print(f\"\\nModel Accuracy (Optimized XGBoost for AD, MCI, HC): {accuracy_major:.4f}\")\n    print(\"\\nClassification Report (Optimized XGBoost for AD, MCI, HC):\")\n    print(report_major)\n\n    # 8. Confusion Matrix for the 3-class model\n    cm_major = confusion_matrix(y_test_major_decoded, y_pred_major, labels=le_major.classes_)\n    \n    plt.figure(figsize=(8, 6))\n    sns.heatmap(cm_major, annot=True, fmt='d', cmap='viridis',\n                xticklabels=le_major.classes_, yticklabels=le_major.classes_)\n    plt.title('Confusion Matrix (Optimized XGBoost for AD, MCI, HC)')\n    plt.ylabel('True Label')\n    plt.xlabel('Predicted Label')\n    plt.show()\n\nelse:\n    print(\"Feature matrix is empty. Please run feature extraction (CELL 6) or load data first.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 📊 Comprehensive Visualization and Model Analysis\n\nGenerates comparative plots (class distribution, model accuracy, ROC curves, and feature importances) for deep performance insights.","metadata":{}},{"cell_type":"code","source":"# ==========================